<?xml version="1.0" encoding="utf-8"?>
<!-- 单文件样本的默认混淆配置：两项"改内存"的保护都开，覆盖最容易在单文件下崩的组合。
     baseDir/outputDir 由 CLI 参数决定，此处为占位。 -->
<project baseDir="." outputDir="." seed="20261010" xmlns="http://confuser.codeplex.com">
  <rule pattern="true" preset="none" inherit="false">
    <protection id="anti dump" />
    <protection id="anti tamper" />
  </rule>
  <module path="SingleFileSample.dll" />
</project>